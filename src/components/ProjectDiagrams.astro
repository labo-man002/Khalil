---
import { url } from '../lib/site';
const diagrams = [
  { title: 'Class architecture', type: 'Runtime responsibilities', file: 'diagrams/class-architecture.svg', caption: 'Server, Scheduler, Placer, their policies, and the topology view. Redrawn from the implemented class diagram in the project documentation.', source: 'https://github.com/labo-man002/job-scheduler/blob/main/docs/architecture.md' },
  { title: 'Entity relationships', type: 'Persisted state', file: 'diagrams/entity-relationships.svg', caption: 'The core ownership, request, allocation, and hardware tables, rendered from actual ORM fields and foreign keys. Open the full schema for quotas, reservations, and usage-table relationships.', source: 'https://github.com/labo-man002/job-scheduler/tree/main/backend/app/models' },
];
---
<section class="project-diagrams" aria-labelledby="diagram-heading">
  <div class="section-heading"><div><span class="eyebrow">Inside the project</span><h2 id="diagram-heading">Classes & relationships.</h2></div><span class="diagram-note">Open a diagram to inspect the full-size SVG ↗</span></div>
  {diagrams.map(d => <figure class="diagram-panel"><div class="diagram-panel-heading"><div><span class="eyebrow">{d.type}</span><h3>{d.title}</h3></div><a class="text-link" href={url(`images/${d.file}`)} target="_blank" rel="noopener noreferrer">Open full size ↗</a></div><a class="diagram-image" href={url(`images/${d.file}`)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${d.title} at full resolution`}><img src={url(`images/${d.file}`)} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption} <a href={d.source} target="_blank" rel="noopener noreferrer">Project source ↗</a></figcaption></figure>)}
  <p class="full-schema-link"><a class="text-link" href={url('images/diagrams/entity-relationships-full.svg')} target="_blank" rel="noopener noreferrer">Open the complete current schema · all 14 tables ↗</a></p>
  <details class="original-schema"><summary>The project’s original ERD drawings <span aria-hidden="true">+</span></summary><p>The original whiteboard and subsystem SVGs are preserved here as design history. The live schema has evolved; the current-model ERD above follows the ORM rather than the older lookup-table design.</p><a href={url('images/project/erd-full-whiteboard.png')} target="_blank" rel="noopener noreferrer"><img src={url('images/project/erd-full-whiteboard.png')} width="1807" height="812" alt="Original whiteboard ERD from the job-scheduler repository, showing the historical schema design" loading="lazy" /></a><div class="original-schema-links">{['topology', 'jobs', 'allocation', 'clients'].map(name => <a href={url(`images/project/erd-${name}.svg`)} target="_blank" rel="noopener noreferrer">{name.charAt(0).toUpperCase()+name.slice(1)} ERD ↗</a>)}</div></details>
</section>
