---
import Base from './Base.astro';
import { profile, url, date } from '../lib/site';
const { frontmatter } = Astro.props;
const headings = Astro.props.headings || [];
---
<Base title={frontmatter.title} description={frontmatter.description} active="writing" image="images/architecture.png"><div class="shell"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('writing/')}>Writing</a><span aria-hidden="true">/</span><span>{frontmatter.category}</span></nav><header class="post-header"><div class="post-meta"><span>{frontmatter.category}</span><span class="meta-divider">/</span><span>{frontmatter.readTime} min read</span></div><h1>{frontmatter.title}</h1><p class="post-deck">{frontmatter.description}</p><div class="post-byline"><span class="author-avatar" aria-hidden="true">k.</span><a href={url('about/')}>{profile.name}</a><span>·</span><time datetime={frontmatter.date}>{date(frontmatter.date)}</time></div></header><div class="article-layout"><article class="prose"><slot /><div class="article-footer"><a class="text-link" href={url('writing/')}>← All engineering notes</a><button class="share-button" id="copy-article" type="button">Copy article link ↗</button></div><p id="copy-status" class="search-status" role="status" aria-live="polite"></p></article><aside class="article-toc" aria-label="On this page"><span class="eyebrow">On this page</span><ul>{headings.filter((h: any) => h.depth === 2).map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul><a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">Source projects ↗</a></aside></div></div><script>
const copy = document.getElementById('copy-article');
copy?.addEventListener('click', async () => {
  const status = document.getElementById('copy-status');
  try { await navigator.clipboard.writeText(window.location.href); if (status) status.textContent = 'Article link copied.'; }
  catch { if (status) { status.replaceChildren(); const label = document.createElement('label'); label.textContent = 'Copy this link: '; const input = document.createElement('input'); input.type = 'text'; input.readOnly = true; input.value = window.location.href; input.setAttribute('aria-label', 'Article URL'); label.appendChild(input); status.appendChild(label); input.focus(); input.select(); } }
});
</script></Base>
