---
import Base from '../layouts/Base.astro';
import Topology from '../components/Topology.astro';
import PostList from '../components/PostList.astro';
import { profile, projects, expertise, experience, url } from '../lib/site';
const posts = Object.values(import.meta.glob('./writing/*.md', { eager: true })).sort((a: any, b: any) => b.frontmatter.date.localeCompare(a.frontmatter.date));
---
<Base>
  <section class="hero shell">
    <div class="hero-copy"><p class="eyebrow"><span class="location-dot"></span> Software infrastructure engineer · Dresden</p><h1>Queues. Graphs.<br /><em>Real machines.</em></h1><p class="hero-description">I’m Khalil. I work on distributed systems, topology-aware resource allocation, and the C++ and Python that connect software to hardware.</p><div class="hero-actions"><a class="button button-dark" href={url('work/')}>Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href={url('about/')}>A little about me <span aria-hidden="true">→</span></a></div><div class="hero-footnote"><span>Currently exploring</span><strong>HPC scheduling & GPU infrastructure</strong></div></div>
    <Topology />
  </section>
  <div class="focus-strip"><div class="shell"><span>C++ & Python</span><span aria-hidden="true">✳</span><span>Distributed systems</span><span aria-hidden="true">✳</span><span>HPC & Slurm</span><span aria-hidden="true">✳</span><span>Topology-aware allocation</span></div></div>
  <section class="section shell" aria-labelledby="work-heading"><div class="section-heading"><div><span class="eyebrow">01 / Selected work</span><h2 id="work-heading">Ideas, made inspectable.</h2></div><a class="text-link" href={url('work/')}>All projects <span aria-hidden="true">↗</span></a></div>
    <a class="featured-project" href={url(`work/${projects[0].slug}/`)}><div class="featured-project-copy"><span class="project-kicker">{projects[0].label}</span><h3>Topology-aware<br />allocation</h3><p>{projects[0].description}</p><div class="tag-list">{projects[0].tags.map(t => <span>{t}</span>)}</div><span class="project-bottom">Explore the architecture <span aria-hidden="true">↗</span></span></div><div class="featured-project-image"><img src={url('images/architecture.png')} alt="Illustrated architecture: API routes, server, scheduler, placer, and PostgreSQL" width="1536" height="1024" loading="lazy" /><span class="image-label">Queue order ≠ resource placement</span></div></a>
    <div class="secondary-projects">{projects.slice(1).map(p => <a class="secondary-project" href={url(`work/${p.slug}/`)}><div class="secondary-project-top"><span class="eyebrow">PROJECT / {p.number}</span><span aria-hidden="true">↗</span></div><h3>{p.title}</h3><p>{p.description}</p><div class="tag-list">{p.tags.map(t => <span>{t}</span>)}</div></a>)}</div>
  </section>
  <section class="writing-section"><div class="section shell"><div class="section-heading"><div><span class="eyebrow">02 / Engineering notes</span><h2>Notes from the implementation.</h2></div><a class="text-link" href={url('writing/')}>All writing <span aria-hidden="true">↗</span></a></div><p class="section-intro">Architecture walkthroughs, small experiments, and the decisions hiding behind the diagrams.</p><PostList posts={posts.slice(0,3)} compact /></div></section>
  <section class="section shell"><div class="section-heading"><div><span class="eyebrow">03 / What I work on</span><h2>Across the system.</h2></div></div><div class="expertise-grid">{expertise.map(e => <div class="expertise-item"><span class="expertise-number">{e.number} /</span><h3>{e.name}</h3><p>{e.description}</p><div class="skill-tags">{e.tags.map(t => <span>{t}</span>)}</div></div>)}</div></section>
  <section class="experience-teaser shell"><div><span class="eyebrow">04 / Experience</span><h2>From performance debugging<br />to hardware allocation.</h2><p>Work at SpiNNcloud and Rohde & Schwarz, with a foundation in physics and software engineering.</p><a class="text-link" href={url('about/#experience')}>The longer version <span aria-hidden="true">→</span></a></div><div class="mini-timeline">{experience.slice(0,2).map(e => <div><span class="timeline-dot"></span><p>{e.date}</p><h3>{e.company}</h3><span>{e.role}</span></div>)}</div></section>
</Base>
