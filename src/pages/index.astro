---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { profile, projects, expertise, homepageExperience, url } from '../lib/site';
const posts = Object.values(import.meta.glob('./writing/*.md', { eager: true })).sort((a: any, b: any) => b.frontmatter.date.localeCompare(a.frontmatter.date));
const allocation = projects.find(p => p.slug === 'topology-aware-allocation')!;
const otherWork = projects.filter(p => p.repository && p.slug !== allocation.slug);
---
<Base>
  <section class="hero shell">
    <div class="hero-copy"><p class="eyebrow"><span class="location-dot"></span> Software infrastructure engineer · Dresden</p><h1>C++ & Python.<br /><em>Distributed systems.</em></h1><p class="hero-description">I’m Khalil, a software infrastructure engineer. I build backend services, resource-allocation software, and tools that make complex systems easier to inspect.</p><div class="hero-actions"><a class="button button-dark" href={url('work/')}>Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href={url('about/')}>About me <span aria-hidden="true">→</span></a></div><div class="hero-footnote"><span>Systems & infrastructure</span><strong>HPC scheduling, graph algorithms, and concurrency</strong></div></div>
    <figure class="machine-hero profile-hero"><a href={url('work/topology-aware-allocation/')}><img src={url('images/project/cluster-detail.png')} alt="The workload-management project showing a torus cluster and node resource state" width="1440" height="780" fetchpriority="high" /></a><figcaption><span>Topology-aware workload management</span><a href={url('work/topology-aware-allocation/')}>Explore the project ↗</a></figcaption></figure>
  </section>
  <div class="focus-strip"><div class="shell"><span>C++ & Python</span><span aria-hidden="true">✳</span><span>Distributed systems</span><span aria-hidden="true">✳</span><span>HPC & Slurm</span><span aria-hidden="true">✳</span><span>Topology-aware allocation</span></div></div>
  <section class="section shell" aria-labelledby="work-heading"><div class="section-heading"><div><span class="eyebrow">01 / Selected engineering work</span><h2 id="work-heading">The implementation, up close.</h2></div><a class="text-link" href={url('work/')}>All work <span aria-hidden="true">↗</span></a></div>
    <a class="featured-project project-screenshot" href={url(`work/${allocation.slug}/`)}><div class="featured-project-copy"><span class="project-kicker">{allocation.label}</span><h3>Topology-aware<br />workload management</h3><p>{allocation.description}</p><div class="tag-list">{allocation.tags.map(t => <span>{t}</span>)}</div><span class="project-bottom">Interface, class diagram & ERD <span aria-hidden="true">↗</span></span></div><div class="featured-project-image"><img src={url('images/project/cluster-detail.png')} alt="Actual job-scheduler UI: 3D torus visualization and individual node resources" width="1440" height="780" loading="lazy" /><span class="image-label">Actual screenshot from the project</span></div></a>
    <div class="secondary-projects">{otherWork.map(p => <a class="secondary-project" href={url(`work/${p.slug}/`)}><div class="secondary-project-top"><span class="eyebrow">{p.repository ? 'PUBLIC PROJECT' : 'PROFESSIONAL WORK'} / {p.number}</span><span aria-hidden="true">↗</span></div><h3>{p.title}</h3><p>{p.description}</p><div class="tag-list">{p.tags.map(t => <span>{t}</span>)}</div></a>)}</div>
  </section>
  <section class="writing-section"><div class="section shell"><div class="section-heading"><div><span class="eyebrow">02 / Engineering notes</span><h2>Notes from the implementation.</h2></div><a class="text-link" href={url('writing/')}>All writing <span aria-hidden="true">↗</span></a></div><p class="section-intro">Architecture walkthroughs, small experiments, and the decisions hiding behind the diagrams.</p><PostList posts={posts.slice(0,3)} compact /></div></section>
  <section class="section shell"><div class="section-heading"><div><span class="eyebrow">03 / What I work on</span><h2>Across the system.</h2></div></div><div class="expertise-grid">{expertise.map(e => <div class="expertise-item"><span class="expertise-number">{e.number} /</span><h3>{e.name}</h3><p>{e.description}</p><div class="skill-tags">{e.tags.map(t => <span>{t}</span>)}</div></div>)}</div></section>
  <section class="experience-teaser shell"><div><span class="eyebrow">04 / Background</span><h2>Software engineering.<br />Performance & systems.</h2><p>Backend development, Linux debugging, and test automation, with a foundation in physics and software engineering.</p><a class="text-link" href={url('about/#experience')}>The longer version <span aria-hidden="true">→</span></a></div><div class="mini-timeline">{homepageExperience.slice(0,2).map(e => <div><span class="timeline-dot"></span><p>{e.date}</p><h3>{e.company}</h3><span>{e.role}</span></div>)}</div></section>
</Base>
