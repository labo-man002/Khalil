---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';
const chapters = [
  { name: 'The request', title: 'The computation is still a mystery.', text: 'A user asks for two GPUs. Perhaps they will train a model. Perhaps they will simulate a universe. The allocator does not need to know the experiment. It needs a request it can reason about.', detail: 'Job 42 · GPU × 2 · illustrative request', scene: 'request' },
  { name: 'The crossing', title: 'Intent becomes a message.', text: 'Across the network, the request is just data. At the API boundary, it becomes a job: an identity, a resource requirement, and an owner whose quota must be checked.', detail: 'The travelling bits are a visual metaphor for an API request.', scene: 'wire' },
  { name: 'The gateway', title: 'Which cluster gets the question?', text: 'The coordinating Server checks admission and chooses the smallest cluster whose total resource-unit count fits the request. That gives the job a destination. It does not guarantee that two GPUs are free right now.', detail: 'Cluster selection and exact resource selection answer different questions.', scene: 'clusters' },
  { name: 'The shape', title: 'A cluster carries its own geometry.', text: 'A ring closes a line. A mesh connects neighbours. A torus wraps its edges; a third dimension adds another direction. The cluster defines the dimensions and wrap rules. Its nodes provide coordinates. Placement uses the resulting view instead of hard-coding one machine shape.', detail: 'Selected links are shown here. Our worked request uses a four-node, non-wrapping mesh row.', scene: 'layouts' },
  { name: 'The queue', title: 'At the front. Still waiting.', text: 'The queue decides whose turn it is. FIFO follows arrival; priority ordering follows job priority. Our request needs two GPUs, but only one is free. Under the default capacity policy, it waits—and this queue pass stops here.', detail: 'Quotas govern admission. Queue order governs the next attempt.', scene: 'queue' },
  { name: 'The opening', title: 'A completion changes the picture.', text: 'An earlier job completes. GPUs 91 and 95 are released. The queue is checked again. Now three GPUs are free for a request that needs two. Counting has done its part. Placement begins.', detail: 'Node 11 remains occupied. It will give the placement policy a reference point.', scene: 'opening' },
  { name: 'The placer', title: 'Look through the machine.', text: 'The Placer sees current, locked inventory. Each cluster supplies its topology configuration; the eligible nodes become a fresh topology view. Coordinates become distances. A list of machines becomes a space in which a policy can make a choice.', detail: 'Try both policies. Same inventory. Same request. A different preference.', scene: 'placement' },
  { name: 'Another lens', title: 'Free is not the same as reachable.', text: 'A coordinate layout describes geometry. A leaf–spine fabric describes paths through switches, ports, links, and node NICs. Its candidate query can reject a free GPU when its node has no usable path. Here, Node 14 has a down NIC.', detail: 'The fabric query is a separate view of candidate discovery; it is not called by the coordinate Placer shown above.', scene: 'fabric' },
  { name: 'The assignment', title: 'Two units. One accountable decision.', text: 'The request said “two GPUs.” The allocation now names the exact units. Separate ownership links connect Job 42 to each selected GPU. The transaction commits that assignment. RUNNING records allocation here; executing the computation belongs to another layer.', detail: 'The system can now answer not just “how many?”, but “which ones belong to this job?”', scene: 'allocation' },
  { name: 'The return', title: 'Ownership ends. Reality still matters.', text: 'When the job completes, the system follows those exact ownership links to release its resources. A healthy node’s GPU becomes available. A GPU on a DOWN node becomes unavailable. Finishing a job cannot repair a machine.', detail: 'The story ends where the next request begins: with trustworthy inventory.', scene: 'release' },
];
---
<Base title="Inside an allocation" description="Follow a two-GPU request through admission, a queue, topology-aware placement, and ownership. An interactive architecture story." active="writing">
<div class="request-story">
  <div class="story-toolbar"><a href={url('writing/from-job-request-to-allocation/')}>← Reading version</a><span>AN ALLOCATION STORY</span><button id="sound" aria-pressed="false">Sound off</button></div>
  <section class="story-intro"><p class="story-kicker">Inside the workload-management project</p><h1>Somewhere,<br />two GPUs<br /><em>are waiting.</em></h1><p>A request arrives. Follow the decisions that turn it into a place on the machine.</p><a href="#journey">Enter the system <span aria-hidden="true">↓</span></a><small>A narrated visual model of the project, not a live cluster.</small></section>
  <noscript><p style="padding:20px 7%">The complete narrative is below. Enable JavaScript for changing visual scenes and placement controls.</p></noscript>
  <div class="journey" id="journey">
    <div class="visual-column"><div class="visual-stage" data-scene="request" data-policy="pack">
      <div class="stage-heading" aria-hidden="true"><span id="scene-label">01 / The request</span><span class="live-dot">JOB 42</span></div>
      <svg viewBox="0 0 680 480" role="img" aria-labelledby="stage-title stage-description">
        <title id="stage-title">A request for two GPUs</title><desc id="stage-description">Scroll through the story to follow the request. The prose describes each decision.</desc>
        <defs><pattern id="story-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="#243b43" stroke-width=".6"/></pattern></defs>
        <rect width="680" height="480" fill="url(#story-grid)" opacity=".45"/>
        <g class="scene request-scene"><path class="orbit" d="M170 240a170 130 0 1 0 340 0a170 130 0 1 0 -340 0"/><rect x="224" y="165" width="232" height="150" rx="8" class="outline"/><text x="340" y="205" class="micro">REQUEST / JOB 42</text><text x="340" y="268" class="big">2 × GPU</text><text x="340" y="350" class="annotation">The work is yours. The placement is ours.</text></g>
        <g class="scene wire-scene"><text x="340" y="150" class="micro">A MESSAGE IN TRANSIT</text><path d="M40 245H640" class="cable"/><path d="M40 245H640" class="signal"/><text x="340" y="210" class="binary">01001010  00101010  00000010</text><rect x="505" y="218" width="130" height="54" rx="5" class="outline"/><text x="570" y="251">API</text><text x="340" y="330" class="annotation">Transport carries intent. Admission gives it context.</text></g>
        <g class="scene clusters-scene"><rect x="240" y="45" width="200" height="60" rx="5" class="outline"/><text x="340" y="82">Server / admission</text><path d="M340 105V145H120V195M340 145V195M340 145H560V195" class="edge"/>{[120,340,560].map((x,i)=><g><rect x={x-85} y="195" width="170" height="145" rx="5" class:list={['outline',{'chosen-cluster':i===1}]}/><text x={x} y="225" class="micro">{['CLUSTER A','CLUSTER B','CLUSTER C'][i]}</text><text x={x} y="270">{['1 GPU unit','4 GPU units','16 GPU units'][i]}</text><text x={x} y="310" class="annotation">{['Too small','Smallest fit','Also fits'][i]}</text></g>)}<text x="340" y="400" class="annotation">Illustrative capacities · topology is configured per cluster</text></g>
        <g class="scene layouts-scene">
          <text x="340" y="40" class="micro">CONFIGURATION → TOPOLOGY → ELIGIBLE NODE VIEW</text>
          <g transform="translate(40 70)"><text x="135" y="20">1D ring</text><path d="M40 65H230V130H40Z" class="edge"/>{[[40,65],[135,65],[230,65],[230,130],[135,130],[40,130]].map(([x,y])=><circle cx={x} cy={y} r="7" class="topology-point"/>)}</g>
          <g transform="translate(365 70)"><text x="135" y="20">2D mesh</text><path d="M40 65H230M40 130H230M40 65V130M135 65V130M230 65V130" class="edge"/>{[40,135,230].map(x=>[65,130].map(y=><circle cx={x} cy={y} r="7" class="topology-point"/>))}</g>
          <g transform="translate(40 250)"><text x="135" y="20">2D torus</text><path d="M40 70H230M40 135H230M40 70V135M135 70V135M230 70V135" class="edge"/><path d="M40 70C-5 15 275 15 230 70M40 70C0 70 0 135 40 135" class="wrap-edge"/>{[40,135,230].map(x=>[70,135].map(y=><circle cx={x} cy={y} r="7" class="topology-point"/>))}</g>
          <g transform="translate(365 250)"><text x="135" y="20">3D torus</text><path d="M50 90H175V155H50ZM100 50H225V115H100ZM50 90L100 50M175 90L225 50M175 155L225 115M50 155L100 115" class="edge"/><path d="M50 90C15 30 260 0 225 50" class="wrap-edge"/>{[[50,90],[175,90],[175,155],[50,155],[100,50],[225,50],[225,115],[100,115]].map(([x,y])=><circle cx={x} cy={y} r="7" class="topology-point"/>)}</g>
          <text x="340" y="455" class="annotation">Dashed green links show representative wrap connections.</text>
        </g>
        <g class="scene queue-scene"><text x="340" y="110" class="micro">PRIORITY ORDER / NEXT ATTEMPT →</text>{[0,1,2].map((i)=><g><rect x={65+i*190} y="180" width="160" height="100" rx="5" class:list={['outline',{'chosen-cluster':i===2}]}/><text x={145+i*190} y="220">{['Job 57','Job 48','Job 42'][i]}</text><text x={145+i*190} y="254" class="annotation">{['waiting','waiting','2 GPUs needed'][i]}</text></g>)}<path d="M605 170V300" class="blocked"/><text x="340" y="355" class="warn">1 free / 2 required</text><text x="340" y="392" class="annotation">No placement attempt can manufacture capacity.</text></g>
        <g class="scene machine-scene"><text x="340" y="80" class="micro">ONE ROW OF A MESH · NO WRAP</text><path d="M105 230H575" class="edge topology-edge"/>{[11,12,13,14].map((id,i)=><g class={`machine machine-${id}`}><rect x={40+i*160} y="170" width="120" height="125" rx="5" class="node-body"/><text x={100+i*160} y="200">Node {id}</text><rect x={60+i*160} y="220" width="80" height="42" rx="3" class="gpu-body"/><text x={100+i*160} y="247" class="gpu-label">{[71,87,91,95][i]}</text><text x={100+i*160} y="320" class="annotation">({i}, 0)</text><text x={100+i*160} y="350" class="distance">{i===0?'occupied':`distance ${i}`}</text></g>)}<text x="340" y="425" class="annotation" id="machine-caption">Three free units. Two will become an allocation.</text></g>
        <g class="scene fabric-scene"><path d="M190 100L150 210M190 100L510 210M490 100L150 210M490 100L510 210M150 230L110 340M150 230L300 340M510 230L550 340" class="edge"/><path d="M190 100L150 210L110 340" class="usable-path"/>{[190,490].map((x,i)=><g><rect x={x-60} y="65" width="120" height="50" rx="4" class="outline"/><text x={x} y="96">Spine {i+1}</text></g>)}{[150,510].map((x,i)=><g><rect x={x-60} y="190" width="120" height="50" rx="4" class="outline"/><text x={x} y="221">Leaf {i+1}</text></g>)}{[110,300,550].map((x,i)=><g><rect x={x-65} y="340" width="130" height="65" rx="4" class="outline"/><text x={x} y="367">Node {12+i}</text><text x={x} y="390" class="annotation">GPU {[87,91,95][i]} free</text></g>)}<path d="M536 297l28 28m0-28l-28 28" class="blocked"/><text x="550" y="280" class="warn">NIC down</text><text x="340" y="453" class="annotation">A cable can exist without a usable path.</text></g>
        <g class="scene ownership-scene"><rect x="245" y="50" width="190" height="60" rx="5" class="outline"/><text x="340" y="87">Job 42 / 2 GPUs</text><path d="M340 110V155" class="edge"/><rect x="230" y="155" width="220" height="60" rx="5" class="outline allocation-record"/><text x="340" y="192" id="record-label">Allocation</text><path d="M340 215V260H180V320M340 260H500V320" class="ownership-links"/>{[180,500].map((x,i)=><g><text x={x} y="293" class="micro">OWNERSHIP LINK {i+1}</text><rect x={x-90} y="320" width="180" height="70" rx="5" class:list={['outline','owned-unit',{'second-owned-unit':i===1}]}/><text x={x} y="350" id={`owned-gpu-${i}`}>GPU {i===0?87:91}</text><text x={x} y="376" class="annotation" id={`unit-state-${i}`}>assigned to Job 42</text></g>)}<text x="340" y="445" class="annotation" id="ownership-caption">A quantity becomes two exact resource identities.</text></g>
      </svg>
      <div class="policy-controls" id="placement-controls" hidden><span>Placement lens</span><div role="group" aria-label="Placement policy"><button data-policy-choice="pack" aria-pressed="true">Pack</button><button data-policy-choice="spread" aria-pressed="false">Spread</button></div><p id="policy-result" role="status">Pack → GPUs 87 + 91. Closer to occupied Node 11.</p></div>
      <nav class="scene-navigation" aria-label="Story chapters">{chapters.map((chapter,i)=><a href={`#chapter-${i}`} aria-label={`${i+1}. ${chapter.name}`} title={chapter.name}>{String(i+1).padStart(2,'0')}</a>)}</nav>
      <div class="stage-progress" aria-hidden="true"><span></span></div>
    </div></div>
    <div class="chapters">{chapters.map((chapter,i)=><section class="chapter" id={`chapter-${i}`} data-scene={chapter.scene} data-index={i} aria-labelledby={`heading-${i}`}><p class="story-kicker">{String(i+1).padStart(2,'0')} / {chapter.name}</p><h2 id={`heading-${i}`}>{chapter.title}</h2><p>{chapter.text}</p><small>{chapter.detail}</small>{chapter.scene==='placement'&&<a class="jump-choice" href="#placement-controls">Explore the placement lens ↑</a>}</section>)}</div>
  </div>
  <section class="story-outro"><p class="story-kicker">The architecture behind the journey</p><h2>A boundary at<br />every decision.</h2><p>Admission chooses a destination. The queue chooses a turn. Placement chooses units. Ownership makes the choice accountable.</p><div><a href={url('writing/from-job-request-to-allocation/')}>Read the architecture story ↗</a><a href="https://github.com/labo-man002/job-scheduler">Explore the source ↗</a></div><a class="restart" href="#journey">Follow the request again ↑</a></section>
</div>
</Base>
<script>
import { chooseUnits } from '../../lib/request-story.mjs';
const stage = document.querySelector<HTMLElement>('.visual-stage')!;
const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
const controls = document.querySelector<HTMLElement>('.policy-controls')!;
const policyButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-policy-choice]')];
let policy = 'pack', current = -1;
const setText = (id: string, value: string) => { const el = document.getElementById(id); if (el) el.textContent = value; };
function updatePolicy() {
  stage.dataset.policy = policy;
  const units = chooseUnits(policy);
  policyButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.policyChoice === policy)));
  setText('policy-result', `${policy === 'pack' ? 'Pack' : 'Spread'} → GPUs ${units.join(' + ')}. ${policy === 'pack' ? 'Closer to' : 'Farther from'} occupied Node 11.`);
  document.querySelectorAll('.machine').forEach(n => n.classList.toggle('selected-unit', units.includes(Number(n.querySelector('.gpu-label')?.textContent))));
  units.forEach((gpu,i) => setText(`owned-gpu-${i}`, `GPU ${gpu}`));
}
policyButtons.forEach(b => b.addEventListener('click', () => { policy = b.dataset.policyChoice!; updatePolicy(); tone(196); }));
let audio: AudioContext | undefined;
let soundEnabled = false;
const soundButton = document.querySelector<HTMLButtonElement>('#sound')!;
function tone(frequency: number) {
  if (!soundEnabled || !audio) return;
  const oscillator = audio.createOscillator(), gain = audio.createGain();
  oscillator.type = 'sine'; oscillator.frequency.setValueAtTime(frequency, audio.currentTime);
  gain.gain.setValueAtTime(0, audio.currentTime); gain.gain.linearRampToValueAtTime(.035, audio.currentTime + .03); gain.gain.exponentialRampToValueAtTime(.001, audio.currentTime + .6);
  oscillator.connect(gain); gain.connect(audio.destination); oscillator.start(); oscillator.stop(audio.currentTime + .65);
}
soundButton.addEventListener('click', async () => {
  if (soundEnabled) { soundEnabled = false; await audio?.suspend(); }
  else { try { audio ??= new AudioContext(); await audio.resume(); soundEnabled = true; } catch { soundButton.textContent = 'Sound unavailable'; return; } }
  soundButton.setAttribute('aria-pressed', String(soundEnabled)); soundButton.textContent = soundEnabled ? 'Sound on' : 'Sound off'; tone(130.81);
});
document.addEventListener('visibilitychange', () => { if (document.hidden && soundEnabled) soundButton.click(); });
function setScene(index: number) {
  if (index === current) return;
  current = index; const chapter = chapters[index];
  stage.dataset.scene = chapter.dataset.scene;
  document.querySelectorAll('.scene-navigation a').forEach((a,i) => { if (i === index) a.setAttribute('aria-current','step'); else a.removeAttribute('aria-current'); });
  setText('scene-label', chapter.querySelector('.story-kicker')!.textContent!);
  setText('stage-title', chapter.querySelector('h2')!.textContent!);
  setText('stage-description', chapter.querySelector('p:not(.story-kicker)')!.textContent!);
  controls.hidden = chapter.dataset.scene !== 'placement';
  stage.style.setProperty('--progress', `${(index + 1) / chapters.length * 100}%`);
  setText('record-label', chapter.dataset.scene === 'release' ? 'Allocation / completed' : 'Allocation');
  setText('unit-state-0', chapter.dataset.scene === 'release' ? 'healthy node → AVAILABLE' : 'assigned to Job 42');
  setText('unit-state-1', chapter.dataset.scene === 'release' ? 'DOWN node → UNAVAILABLE' : 'assigned to Job 42');
  setText('ownership-caption', chapter.dataset.scene === 'release' ? 'Ownership released. Machine state decides availability.' : 'A quantity becomes two exact resource identities.');
  tone([130.81,164.81,196,174.61,146.83,220,261.63,174.61,329.63,130.81][index]);
}
let scheduled = false;
function syncScroll() {
  scheduled = false;
  const anchor = innerHeight * (innerWidth <= 760 ? .72 : .52);
  let index = 0;
  chapters.forEach((c,i) => { if (c.getBoundingClientRect().top <= anchor) index = i; });
  setScene(index);
}
addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(syncScroll); } }, { passive: true });
addEventListener('resize', syncScroll);
updatePolicy(); syncScroll();
</script>
<style>
