.story-toolbar{position:sticky;top:0;z-index:5;background:#0a161cf2;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:22px 5%;border-bottom:1px solid #293d44;font:11px/1.4 monospace;letter-spacing:.1em}.story-toolbar a{color:#bdcccd}.story-toolbar button{color:var(--mint);background:transparent;border:1px solid #49615d;padding:8px 12px;cursor:pointer}.story-toolbar span{color:var(--muted)}
.story-intro{min-height:85svh;padding:90px 9% 75px;position:relative;background:radial-gradient(ellipse at 85% 45%,#21403b80,transparent 55%)}.story-kicker{text-transform:uppercase;letter-spacing:.17em;font:11px/1.5 monospace;color:var(--mint);margin-bottom:24px}.story-intro h1{font-size:clamp(65px,8.5vw,130px);line-height:.98;font-weight:400;letter-spacing:-.06em;max-width:1000px;color:#edf4ed;margin:0 0 35px}.story-intro h1 em{font-weight:400;color:var(--mint);font-family:Georgia,serif}.story-intro>p:not(.story-kicker){max-width:380px;font-size:18px;line-height:1.7;color:#b6c8c8}.story-intro>a{display:inline-flex;gap:35px;border-bottom:1px solid #6c9e83;padding:18px 0;color:var(--mint);margin:20px 0}.story-intro small{display:block;font-size:11px;color:var(--muted)}
.journey{display:grid;grid-template-columns:57% 43%;position:relative;max-width:1600px;margin:auto}.visual-column{position:relative;min-width:0}.visual-stage{position:sticky;top:24px;margin:0 3% 0 7%;border:1px solid #2f484e;background:#0d1c22;overflow:hidden}.stage-heading{display:flex;justify-content:space-between;padding:20px;font:10px/1.5 monospace;letter-spacing:.08em;color:var(--muted)}.live-dot{color:var(--mint)}.live-dot:before{content:'●';font-size:8px;margin-right:7px}.visual-stage svg{display:block;width:100%;height:auto}.scene-navigation{display:flex;justify-content:space-between;gap:4px;padding:12px 18px;border-top:1px solid #293d44}.scene-navigation a{font:11px monospace;color:#a9bfc1;padding:7px 3px}.scene-navigation a[aria-current=step]{color:#b8f3c9;border-bottom:1px solid #b8f3c9}.stage-progress{height:2px;background:#243a40}.stage-progress span{display:block;width:var(--progress,11%);height:100%;background:var(--mint);transition:width .4s}.chapters{padding:0 13% 0 7%}.chapter{min-height:90svh;display:flex;flex-direction:column;justify-content:center;padding:80px 0;scroll-margin-top:40px}.chapter h2{font-size:clamp(30px,3vw,47px);font-weight:400;line-height:1.12;letter-spacing:-.035em;color:#edf4ed;margin:0 0 27px}.chapter>p:not(.story-kicker){font-size:17px;line-height:1.85;color:#c2d0d0;margin:0 0 23px}.chapter small{font-size:12px;line-height:1.7;color:var(--muted);border-left:1px solid #466357;padding-left:15px}.jump-choice{font-size:12px;color:var(--mint);margin-top:20px}.policy-controls{padding:0 24px 22px}.policy-controls[hidden]{display:none}.policy-controls>span{font:10px monospace;text-transform:uppercase;letter-spacing:.13em;color:var(--muted)}.policy-controls>div{display:inline-flex;margin-left:20px;gap:5px}.policy-controls button{border:1px solid #49615d;background:transparent;color:#bdcccd;padding:7px 15px;cursor:pointer;font-size:12px}.policy-controls button[aria-pressed=true]{background:var(--mint);color:#10251b;border-color:var(--mint)}.policy-controls p{font:12px/1.6 monospace;color:var(--mint);margin:16px 0 0}
svg text{fill:#dde9e5;text-anchor:middle;font:17px monospace}svg .micro{font-size:12px;letter-spacing:1px;fill:#9db4b7}svg .big{font-size:37px;fill:#b9efc8}svg .annotation{font-size:12px;fill:#9db4b7}svg .binary{font-size:15px;letter-spacing:3px;fill:#a9e7bd}svg .outline{fill:#10232a;stroke:#607d7e;stroke-width:1.3}svg .orbit{fill:none;stroke:#416659;stroke-dasharray:3 9}svg .cable{stroke:#304f56;stroke-width:12}svg .signal{stroke:#b8f3c9;stroke-width:3;stroke-dasharray:25 575;animation:transit 3s linear infinite}svg .edge{fill:none;stroke:#59767d;stroke-width:1.5}svg .chosen-cluster{stroke:#b3ecc5;fill:#213d32}svg .blocked{stroke:#e8a88b;stroke-width:3}svg .warn{fill:#e8a88b;font-size:14px}svg .usable-path{fill:none;stroke:#b3ecc5;stroke-width:4}svg .topology-point{fill:#b4eac6;stroke:#10232a;stroke-width:2}svg .wrap-edge{fill:none;stroke:#a9e7bd;stroke-width:1.5;stroke-dasharray:5 5}svg .node-body{fill:#10232a;stroke:#617b80;stroke-width:1.5}svg .gpu-body{fill:#294e3d;stroke:#9fd2b0;stroke-width:1.3}svg .machine-11 .gpu-body{fill:#604b3e;stroke:#d3ab8e}svg .distance{font-size:12px;fill:#a9e7bd;opacity:0}svg .ownership-links{fill:none;stroke:#a9e7bd;stroke-width:2}.scene{display:none}
