---
import Base from '../../layouts/Base.astro';
import { projects, url } from '../../lib/site';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<Base title={project.title} description={project.description} active="work" image={`images/${project.image}`}><div class="shell"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('work/')}>Work</a><span aria-hidden="true">/</span><span>{project.title}</span></nav><header class="project-hero"><span class="eyebrow">{project.label}</span><h1>{project.title}</h1><p>{project.description}</p><div class="project-links"><a class="button button-dark" href={project.repository} target="_blank" rel="noopener noreferrer">Explore the repository <span aria-hidden="true">↗</span></a><span class="project-status">{project.status}</span></div></header><div class="project-cover"><img src={url(`images/${project.image}`)} width="1536" height="1024" alt={`${project.title} explanatory diagram`} /></div><div class="project-body"><aside class="project-aside"><span class="eyebrow">What this project is for</span><p>{project.outcome}</p><div class="tag-list">{project.tags.map(t => <span>{t}</span>)}</div></aside><div class="project-sections">{project.sections.map(s => <section><h2>{s.title}</h2><p>{s.text}</p></section>)}<a class="text-link" href={url('writing/')}>Related engineering notes <span aria-hidden="true">→</span></a></div></div></div></Base>
