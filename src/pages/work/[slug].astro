---
import Base from '../../layouts/Base.astro';
import ProjectDiagrams from '../../components/ProjectDiagrams.astro';
import { projects, url } from '../../lib/site';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<Base title={project.title} description={project.description} active="work" image={`images/${project.image}`}>
  <div class="shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url('work/')}>Work</a><span aria-hidden="true">/</span><span>{project.title}</span></nav>
    <header class="project-hero"><span class="eyebrow">{project.label}</span><h1>{project.title}</h1><p>{project.description}</p><div class="project-links"><a class="button button-dark" href={project.repository || project.externalUrl || '#'} target="_blank" rel="noopener noreferrer">{project.repository ? 'Explore the repository' : 'Sparxity — company website'} <span aria-hidden="true">↗</span></a><span class="project-status">{project.status}</span></div></header>
    <figure class:list={['project-cover', { 'machine-cover': !project.repository }]}><img src={url(`images/${project.image}`)} width="1440" height="900" alt={project.imageAlt} /><figcaption>{project.imageCredit}{!project.repository && <> · <a href="https://sparxity.ai/" target="_blank" rel="noopener noreferrer">sparxity.ai ↗</a></>}</figcaption></figure>
    <div class="project-body"><aside class="project-aside"><span class="eyebrow">{project.repository ? 'What this project is for' : 'My engineering focus'}</span><p>{project.outcome}</p><div class="tag-list">{project.tags.map(t => <span>{t}</span>)}</div></aside><div class="project-sections">{project.sections.map(s => <section><h2>{s.title}</h2><p>{s.text}</p></section>)}<a class="text-link" href={url('writing/')}>Engineering notes <span aria-hidden="true">→</span></a></div></div>
    {project.slug === 'topology-aware-allocation' && <><section class="project-interface"><span class="eyebrow">The actual application</span><h2>Cluster state and job history.</h2><div class="screenshot-grid"><figure><a href={url('images/project/clusters.png')} target="_blank" rel="noopener noreferrer"><img src={url('images/project/clusters.png')} alt="Actual cluster overview listing ring, torus, and mesh clusters" width="1440" height="780" loading="lazy" /></a><figcaption>Cluster overview · repository screenshot</figcaption></figure><figure><a href={url('images/project/job-detail.png')} target="_blank" rel="noopener noreferrer"><img src={url('images/project/job-detail.png')} alt="Actual job page with resource requirements, allocation, and lifecycle events" width="1440" height="900" loading="lazy" /></a><figcaption>Job detail · repository screenshot</figcaption></figure></div></section><ProjectDiagrams /></>}
  </div>
</Base>
