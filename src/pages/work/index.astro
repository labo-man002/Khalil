---
import Base from '../../layouts/Base.astro';
import { projects, url } from '../../lib/site';
---
<Base title="Selected work" active="work"><section class="page-intro shell"><p class="eyebrow">Professional work & public projects</p><h1>Supercomputer software.<br /><em>Public experiments.</em></h1><p>My work on SpiNNaker2 infrastructure at Sparxity, followed by the workload-management project and an interactive scheduling laboratory.</p></section><section class="shell work-list">{projects.map(p => <a class:list={['featured-project', 'project-screenshot', { 'professional-project': !p.repository }]} href={url(`work/${p.slug}/`)}><div class="featured-project-copy"><span class="project-kicker">{p.number} / {p.label}</span><h3>{p.title}</h3><p>{p.description}</p><div class="tag-list">{p.tags.map(t => <span>{t}</span>)}</div><span class="project-bottom">{p.repository ? 'Inspect the project' : 'Read about my contribution'} <span aria-hidden="true">↗</span></span></div><div class="featured-project-image"><img src={url(`images/${p.image}`)} width="1440" height="900" loading="lazy" alt={p.imageAlt} /><span class="image-label">{p.status}</span></div></a>)}</section></Base>
