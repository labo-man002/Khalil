{
  "name": "khalil-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:game",
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs && npm run test:game",
    "check:links": "node scripts/check-links.mjs",
    "prebuild": "npm run build:game",
    "build:game": "node scripts/build-game.mjs",
    "dev:game": "vite games/hidden-layers-of-truth",
    "test:game": "node --test games/hidden-layers-of-truth/tests/*.test.mjs",
    "test:game:browser": "node games/hidden-layers-of-truth/tests/browser.mjs"
  },
  "dependencies": {
    "astro": "7.4.8"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "vite": "8.3.7"
  }
}
